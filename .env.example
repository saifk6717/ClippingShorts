# ============================================================================================================
# ClippingShorts settings. Copy to .env and fill in. Never commit .env (it is in .gitignore).
# ============================================================================================================

# ---- sign-in (required) -------------------------------------------------------------------------------------
# A long random value, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLIPPINGSHORTS_SECRET_KEY=
# Full-control password (at least 10 characters) and an optional read-only one
CLIPPINGSHORTS_ADMIN_PASSWORD=
CLIPPINGSHORTS_VIEWER_PASSWORD=
# Optional token for scripts: Authorization: Bearer <token>
CLIPPINGSHORTS_API_TOKEN=
# Set to 1 when the dashboard is served over HTTPS
CLIPPINGSHORTS_COOKIE_SECURE=0
# Where the dashboard listens on this machine
CLIPPINGSHORTS_FRONTEND_BIND=0.0.0.0
CLIPPINGSHORTS_FRONTEND_PORT=3100

# ---- Redis --------------------------------------------------------------------------------------------------
# Containers reach Redis by its container/service name on a shared Docker network, not "localhost".
REDIS_NETWORK=redis_redis_network
REDIS_URL=redis://redis:6379/4
# every key starts with this, so a Redis shared with other apps is never collided with
REDIS_PREFIX=cs:
# COMPOSE_PROFILES=bundled-redis   # only if you have no Redis (see docker-compose.yml)

# ---- database -----------------------------------------------------------------------------------------------
# Empty = SQLite on the data volume. For PostgreSQL: postgresql+psycopg://user:password@host:5432/clippingshorts
DATABASE_URL=

# ---- Google Cloud: Gemini (highlight judges) + Speech-to-Text Chirp 3 -----------------------------------------
# Path ON THIS MACHINE to a service-account JSON key with Vertex AI User + Cloud Speech Client roles.
# It is mounted into the containers as a Docker secret.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CLOUD_PROJECT=
AI_MODE=gemini                 # gemini | local (no AI calls) | mock (tests)
GEMINI_MODEL=gemini-3.8-flash  # used exactly as written; never silently replaced
GEMINI_LOCATION=global
# empty = the model's default thinking (fastest in tests); "low" or "high" are also accepted
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_SECONDS=90
GEMINI_DAILY_REQUEST_BUDGET=3000
# Fill in current prices from the Google Cloud pricing page to see cost estimates (USD)
GEMINI_PRICE_INPUT_PER_M_TOKENS=0
GEMINI_PRICE_OUTPUT_PER_M_TOKENS=0
TRANSCRIPTION_PROVIDER=chirp3  # chirp3 | parakeet | mock | none
TRANSCRIPTION_FALLBACK=none    # parakeet needs the image built with INSTALL_PARAKEET=1 and ~1 GB more RAM
SPEECH_LOCATION=us             # Chirp 3 is available in "us" and "eu"
SPEECH_LANGUAGE=en-US
SPEECH_DAILY_MINUTES_BUDGET=1500
SPEECH_PRICE_PER_MINUTE=0

# ---- YouTube (live chat + publishing) -------------------------------------------------------------------------
# OAuth client of your Google Cloud project + a refresh token with youtube.upload and youtube.readonly scopes
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CATEGORY_ID=20
YOUTUBE_CHAT_DAILY_QUOTA_BUDGET=4000
AUTO_UPLOAD=off                # off | private | unlisted | public
AUTO_UPLOAD_MIN_CONFIDENCE=85
# YouTube may refuse video downloads from servers ("confirm you're not a bot"). Then provide a cookies.txt
# (Netscape format, placed in the data volume) and/or a proxy.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# ---- resource limits: starting points, measure and tune (scripts/loadtest.py) ---------------------------------
MAX_STREAMS=10
MAX_CONCURRENT_TRANSCRIPTIONS=3
MAX_CONCURRENT_AI_JOBS=3
MAX_CONCURRENT_RENDER_JOBS=1
MAX_CONCURRENT_EXTRACTIONS=2
MAX_FFMPEG_PROCESSES=14
STREAM_WORKER_MEM_LIMIT_MB=400
RESOURCE_CPU_HIGH_PCT=85
RESOURCE_MEM_HIGH_PCT=80
RESOURCE_MEM_CRITICAL_PCT=90
RESOURCE_DISK_HIGH_PCT=85
STORAGE_LIMIT_GB=50
RENDER_THREADS=2
# container ceilings (docker-compose.yml)
STREAM_WORKER_MEM_LIMIT=1536m
AI_WORKER_MEM_LIMIT=512m
RENDERER_MEM_LIMIT=1024m

# ---- rolling buffer & clips ----------------------------------------------------------------------------------
SEGMENT_SECONDS=4
ROLLING_BUFFER_SECONDS=180
HIGHLIGHT_PRE_SECONDS=20         # a Short = 20 s before ...
HIGHLIGHT_POST_SECONDS=20        # ... and 20 s after the detected moment (40 s)
FIXED_SHORT_RANGE=1
SOURCE_CLIP_PRE_SECONDS=120    # the saved source recording: 2-5 minutes around a highlight
SOURCE_CLIP_POST_SECONDS=40
SOURCE_CLIP_RETENTION_DAYS=14  # 0 = keep forever
MAX_INGEST_HEIGHT=720

# ---- detection -------------------------------------------------------------------------------------------------
LOCAL_TRIGGER_SCORE=55
# 0 = transcribe only saved Shorts (cheap); 1 = whole streams live (costly, enables the words judge)
LIVE_TRANSCRIPTION=0
# with live transcription off, the reaction judge alone must score at least this
ACCEPT_REACTION_ONLY_MIN=70
CANDIDATE_COOLDOWN_SECONDS=45
AI_EVAL_INTERVAL_SECONDS=300
MAX_HIGHLIGHTS_PER_HOUR=8
MAX_CANDIDATES_PER_HOUR=40

# ---- testing --------------------------------------------------------------------------------------------------
CLIPPINGSHORTS_ENABLE_SYNTHETIC=0
